      "source": [
        "def knapsack(wt,val,W):\n",
        "    dp=[0]*(W+1)\n",
        "    for i in range(len(val)):\n",
        "        for w in range(W,wt[i]-1,-1):\n",
        "            dp[w]=max(dp[w],val[i]+dp[w-wt[i]])\n",
        "    return dp[W]\n",
        "print(\"Maximum project value:\",\n",
        "      knapsack([2,3,4],[40,50,70],5))"
      ]
    }
  ]
}